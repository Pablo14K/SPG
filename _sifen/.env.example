# ============================================================
# AUTOMATIZADOR SIFEN — Variables de entorno
# Copiá este archivo como  .env  y completá tus datos.
# (.env está ignorado por git para no versionar credenciales)
# ============================================================

# ── EMISOR (tu empresa) ──────────────────────────────────────
EMISOR_AMBIENTE=test
EMISOR_RUC=80012345
EMISOR_DV=6
EMISOR_TIPO_CONTRIBUYENTE=2
EMISOR_RAZON_SOCIAL=MI EMPRESA S.A.
EMISOR_NOMBRE_FANTASIA=Mi Empresa
EMISOR_DIRECCION=Avda. Ejemplo 123
EMISOR_NUMERO_CASA=123
EMISOR_COD_DEPARTAMENTO=11
EMISOR_DESC_DEPARTAMENTO=CAPITAL
EMISOR_COD_DISTRITO=1
EMISOR_DESC_DISTRITO=ASUNCION (DISTRITO)
EMISOR_COD_CIUDAD=1
EMISOR_DESC_CIUDAD=ASUNCION (DISTRITO)
EMISOR_TELEFONO=021000000
EMISOR_EMAIL=facturacion@miempresa.com
EMISOR_COD_ACTIVIDAD=47190
EMISOR_DESC_ACTIVIDAD=VENTA AL POR MENOR
EMISOR_TIMBRADO=12345678
EMISOR_TIMBRADO_INICIO=2026-01-01
EMISOR_TIMBRADO_FIN=2026-12-31
EMISOR_ESTABLECIMIENTO=001
EMISOR_PUNTO=001

# ── CSC (otorgado por la DNIT) ───────────────────────────────
# En modo mock podés usar el valor demo de abajo.
# En test/prod reemplazalo por el CSC real.
SIFEN_ID_CSC=0001
SIFEN_CSC=ABCD0000000000000000000000000001

# ── ENDPOINT HTTP (cuando el sistema "vive" en el servidor) ──
# URL pública donde queda publicada la carpeta public/ (para armar los links de descarga).
APP_URL=https://facturacion.tudominio.com
# Token de seguridad para la API. Si lo dejás vacío, el endpoint es PÚBLICO
# (solo recomendable en red privada). Generá uno largo y aleatorio.
SIFEN_API_TOKEN=

# ── MODO DE EMISIÓN ──────────────────────────────────────────
# mock = sin valor fiscal (para pruebas)
# test = ambiente de pruebas DNIT (requiere certificado)
# prod = producción real DNIT (requiere certificado habilitado)
SIFEN_MODE=mock

# ── CERTIFICADO (solo modo test/prod) ────────────────────────
SIFEN_CERT_P12_PATH=
SIFEN_CERT_P12_PASSWORD=
SIFEN_CERT_PEM_PATH=
SIFEN_PRIVATE_KEY_PEM_PATH=
SIFEN_PRIVATE_KEY_PASSWORD=

# ── WEB SERVICES DNIT (solo modo test/prod) ──────────────────
SIFEN_URL_RECEP_DE=
SIFEN_URL_CONS_DE=
SIFEN_URL_CONS_RUC=

# ── CORREO (quien envía la factura al cliente) ───────────────
# Si MAIL_FROM_EMAIL está vacío, el envío se omite silenciosamente.
# transport: smtp = envío real | file = guarda .eml en logs/emails/ (para pruebas)
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_FROM_EMAIL=tucorreo@gmail.com
MAIL_FROM_NAME=Facturación Electrónica
