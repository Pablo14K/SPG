# =========================================================================
#  Plantilla del .env del SERVIDOR. No es la de desarrollo (.env.example).
#
#  Copiala al VPS como `.env`, completá lo que está entre <>, y comprobá con:
#
#      php artisan spg:diagnostico --produccion
#
#  Tiene que terminar sin observaciones ANTES de dar el sistema por publicado.
#  Los cuatro valores de arriba son los que la auditoría encontró mal puestos
#  al desplegar con el .env de desarrollo, y ninguno avisa cuando está mal:
#  simplemente el sistema hace algo distinto de lo que se espera.
# =========================================================================

APP_NAME="Peluquería Luque"

# `production` apaga las pantallas de depuración del framework.
APP_ENV=production

# **false, siempre.** Con true, cualquier error le muestra al visitante la
# traza completa — y ahí adentro va la contraseña de la base.
APP_DEBUG=false

# Se genera UNA vez en el servidor con `php artisan key:generate`.
# Si se cambia después, las sesiones abiertas y lo cifrado dejan de leerse.
APP_KEY=

# **El subdominio real, con https.** De acá salen los enlaces de los correos:
# reprogramar, cancelar y agregar la cita al calendario. Con el valor de
# desarrollo, al cliente le llega un enlace a su propia computadora.
APP_URL=https://<subdominio>.<dominio-de-la-facultad>

# Paraguay quedó fijo en UTC-3. NO dejar en UTC: `ahora_bd()` sella el fichaje
# con la hora de la base, y un VPS recién instalado corre en UTC — el fichaje
# quedaría cuatro horas corrido. Comprobar con SELECT NOW() contra el reloj.
APP_TIMEZONE=America/Asuncion

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PY
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` en producción llena el disco y escribe datos de clientes en el log.
LOG_LEVEL=warning

# -------------------------------------------------------------------------
#  Base de datos
#
#  Se instala `basededatos/peluqueria_bd(base).sql`, la vacía. NUNCA el mes
#  simulado: son las clientas y las facturas de la simulación del QA.
#
#  El usuario del grupo necesita CREATE ROUTINE, ALTER ROUTINE, TRIGGER y
#  EXECUTE, y hay que pasar el volcado por:
#      php artisan spg:preparar-sql <archivo> <usuario>
#  para reescribir los 84 DEFINER que apuntan a root@localhost.
# -------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peluqueria_bd
DB_USERNAME=<usuario_del_grupo>
DB_PASSWORD=<contraseña>

# A archivo, no a `database`: con `database` Laravel crea SUS tablas dentro de
# la base del TCC, que es la que se entrega al salón.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Con HTTPS, la cookie de sesión no debería viajar en claro.
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -------------------------------------------------------------------------
#  Correo saliente — puerto 587
#
#  Por acá salen el código de verificación del registro, la recuperación de
#  contraseña, el segundo factor del cambio de clave y los recordatorios de
#  cita. Si el proveedor bloquea el 587, el registro de clientas no funciona:
#  confirmarlo ANTES de pagar el hosting.
#
#  La contraseña va sólo acá, en el servidor. Nunca en el repositorio.
# -------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=<smtp del proveedor>
MAIL_PORT=587
MAIL_USERNAME=<cuenta>
MAIL_PASSWORD=<contraseña de aplicación>
MAIL_FROM_ADDRESS="<la misma cuenta que se autentica>"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
#  Después de copiar este archivo, en el servidor:
#
#    composer install --no-dev --optimize-autoloader
#    php artisan key:generate
#    php artisan optimize            # config, rutas y vistas en caché
#    php artisan spg:diagnostico --produccion
#
#  Y en el cron del panel, una sola línea:
#    * * * * * cd /ruta && php artisan schedule:run >> /dev/null 2>&1
#
#  La carpeta pública del sitio apunta a `public/`, NUNCA a la raíz: si apunta
#  a la raíz, este archivo queda descargable por HTTP con la contraseña adentro.
# =========================================================================

# -------------------------------------------------------------------------
#  Facturación electrónica (Automatizador SIFEN)
#
#  Sólo se enciende si el salón declara ante la DNIT. Con `false` el módulo
#  no existe en la interfaz.
#
#  En producción va `http`, nunca `simulado`: el modo simulado devuelve un
#  CDC de prueba que NO tiene validez fiscal, y la pantalla lo avisa, pero
#  conviene no dejarlo puesto por descuido.
#
#  El Automatizador es un proyecto aparte y se despliega por su cuenta: acá
#  sólo va la dirección donde quedó publicado y su token.
# -------------------------------------------------------------------------
SIFEN_ACTIVO=false
SIFEN_MODO=http
SIFEN_URL=https://<automatizador>/public/
SIFEN_TOKEN=<token del automatizador>
SIFEN_TIPO_DEFECTO=8
