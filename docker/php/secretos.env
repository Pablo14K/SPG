# ---------------------------------------------------------------------------
# Lo que NO se versiona: contraseñas y tokens.
#
# **Esto existe para que `docker/php/env.docker` pueda commitearse.** Con la
# contraseña adentro, ese archivo tenía que ir con `git update-index
# --skip-worktree`, y eso esconde TODOS sus cambios: el repositorio quedó una
# vez con `SIFEN_TIPO_DEFECTO` apuntando a un comprobante dado de baja porque
# nadie vio que la corrección no se había commiteado (ver la 7.12.1).
#
# Docker lo pasa como variables de entorno del contenedor, y Laravel las
# respeta: Dotenv arranca en modo inmutable, así que NO pisa una variable que
# ya está puesta. Lo de acá le gana a lo del `.env`.
#
# Si este archivo no existe, `docker compose up` falla con un mensaje claro.
# Copiá `secretos.env.example` y completá lo tuyo.
# ---------------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=cacerespablo13m@gmail.com
MAIL_PASSWORD=sdqgroqlkitdnomy
MAIL_FROM_ADDRESS="cacerespablo13m@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
SIFEN_TOKEN=TOKEN_LARGO_ALEATORIO_4F8A2C

# ===========================================================================
#  Lo que el SERVIDOR necesita además. Sin estas cinco, MariaDB no inicializa
#  y el contenedor del app se apaga a propósito.
#
#  **Están acá porque el despliegue se hace desde el Administrador de Docker
#  de Hostinger, que clona el repositorio en un temporal nuevo cada vez: no
#  hay dónde dejar un archivo aparte.** Ver DESPLIEGUE.md, punto 2.
# ===========================================================================

# Las dos son LA MISMA: la primera la usa MariaDB al crearse, la segunda es con
# la que se conecta Laravel. La base no publica ningún puerto, así que sólo se
# llega a ella desde la red interna de Docker.
MYSQL_ROOT_PASSWORD=a7rkGtaV0vQdCEgyMih2R5cWw0xo
DB_PASSWORD=a7rkGtaV0vQdCEgyMih2R5cWw0xo

# Se genera UNA vez. Si cambia, las sesiones abiertas y todo lo cifrado dejan
# de leerse.
APP_KEY=base64:DE4Qx167LDOngOxAGD/LOfSRIDvvWbxNJ8lYwx6C1qU=

