# PHP 8.3 para el SERVIDOR. El de desarrollo es `Dockerfile`, al lado.
#
# **El contexto de build es la RAÍZ del proyecto, no esta carpeta**, y el código
# se COPIA adentro en vez de montarse. No es una preferencia: el panel de
# Hostinger corre el compose desde el clon pero resuelve los volúmenes contra
# `/docker/spg`, que está vacío, así que un montaje de host queda apuntando a la
# nada —o peor, Docker crea una CARPETA donde tenía que haber un archivo—. El
# contexto de build, en cambio, sí sale del clon. Ver DESPLIEGUE.md, punto 2.
#
# La otra diferencia con desarrollo: allá el servidor lo levanta
# `php artisan serve`, que **atiende una petición por vez**. En un servidor con
# tres personas usando el sistema, una pantalla lenta deja a las otras dos
# esperando. Acá va `php-fpm`, y quien atiende el HTTP es Caddy.
FROM php:8.3-fpm

# Las mismas extensiones que en desarrollo, más OPcache: guarda el bytecode ya
# compilado en memoria, así PHP no vuelve a leer y parsear las mismas ~600
# clases en cada petición.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libzip-dev unzip mariadb-client \
    && docker-php-ext-install pdo_mysql zip opcache \
    && apt-get purge -y --auto-remove \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# `validate_timestamps=0` hace que OPcache no vuelva a mirar el disco nunca. Es
# correcto acá **y** es la trampa que va con esto: después de subir código nuevo
# hay que reconstruir la imagen, o se sigue sirviendo el viejo sin que nada
# avise. El panel reconstruye en cada despliegue, así que queda cubierto.
RUN { \
      echo 'opcache.enable=1'; \
      echo 'opcache.memory_consumption=128'; \
      echo 'opcache.max_accelerated_files=10000'; \
      echo 'opcache.validate_timestamps=0'; \
      echo 'expose_php=Off'; \
      echo 'upload_max_filesize=8M'; \
      echo 'post_max_size=10M'; \
    } > /usr/local/etc/php/conf.d/spg.ini

ENV TZ=America/Asuncion
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

# Primero sólo lo que define las dependencias: mientras `composer.json` y
# `composer.lock` no cambien, Docker reusa esta capa y el build siguiente no
# vuelve a bajar 83 paquetes.
COPY composer.json composer.lock ./
RUN composer install --no-interaction --prefer-dist --no-dev \
        --optimize-autoloader --no-scripts --no-autoloader

# Y ahora el proyecto. Lo que NO entra está en `.dockerignore`, empezando por el
# `.env` de la computadora de quien desarrolla.
COPY . /app

# El `.env` del servidor. Se copia con nombre distinto a propósito: así el del
# repositorio sigue siendo legible como lo que es —la configuración del
# servidor— y no se confunde con el de desarrollo. **Las credenciales NO están
# acá adentro**: entran como variables del contenedor desde `secretos.env`, que
# Compose lee del clon.
COPY docker/php/env.produccion /app/.env

RUN composer dump-autoload --optimize --no-dev \
    && mkdir -p storage/framework/sessions storage/framework/views \
                storage/framework/cache storage/logs storage/app/sifen \
                bootstrap/cache public/assets/servicios public/assets/logo \
    && chown -R www-data:www-data storage bootstrap/cache public/assets

COPY docker/php/entrada-produccion.sh /usr/local/bin/entrada
# Si el archivo viajó desde Windows con fin de línea CRLF, el contenedor
# contesta «bad interpreter» y no hay forma de adivinar por qué.
RUN sed -i 's/\r$//' /usr/local/bin/entrada && chmod +x /usr/local/bin/entrada

EXPOSE 9000
ENTRYPOINT ["entrada"]
