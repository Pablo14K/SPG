# ---------------------------------------------------------------------------
# Copiá este archivo como `secretos.env` y completá lo tuyo.
#
# Va aparte de `env.docker` para que ESE pueda versionarse: con la contraseña
# adentro había que esconderlo con `skip-worktree`, y entonces ningún cambio
# suyo se commiteaba ni aparecía en `git status`.
#
# Sin correo configurado el sistema NO manda el código de verificación, ni la
# recuperación de contraseña, ni el segundo factor, ni los recordatorios — y no
# avisa: la pantalla dice «te enviamos un código» igual. `spg:diagnostico` tiene
# una sección de correo justamente para que eso se vea.
# ---------------------------------------------------------------------------

# Gmail pide una «contraseña de aplicación», no la de la cuenta:
#   myaccount.google.com/apppasswords
# El remitente tiene que ser la MISMA cuenta que se autentica, o Gmail rechaza.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Peluqueria Luque"

# Tiene que coincidir con el `SIFEN_API_TOKEN` del Automatizador, o contesta
# 401 — y el SPG lee un 401 como RECHAZADO, o sea «no reintentes».
SIFEN_TOKEN=
