# ---------------------------------------------------------------------------
# Copiá este archivo como `secretos.env` y completá lo tuyo.
#
# Es «los secretos de ESTA máquina»: en la computadora de quien desarrolla
# alcanza con la primera sección, y en el servidor hacen falta también las de
# abajo. Un solo archivo y un solo nombre para las dos cosas, así no hay que
# acordarse de cuál va dónde.
#
# Va aparte de `env.docker` / `env.produccion` para que ESOS puedan versionarse:
# con la contraseña adentro había que esconderlos con `skip-worktree`, y
# entonces ningún cambio suyo se commiteaba ni aparecía en `git status`.
#
# Sin correo configurado el sistema NO manda el código de verificación, ni la
# recuperación de contraseña, ni el segundo factor, ni los recordatorios — y no
# avisa: la pantalla dice «te enviamos un código» igual. `spg:diagnostico` tiene
# una sección de correo justamente para que eso se vea.
# ---------------------------------------------------------------------------

# ===========================================================================
#  1. Correo — hace falta en las dos, desarrollo y servidor
# ===========================================================================

# Gmail pide una «contraseña de aplicación», no la de la cuenta:
#   myaccount.google.com/apppasswords
# El remitente tiene que ser la MISMA cuenta que se autentica, o Gmail rechaza.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Peluqueria Luque"

# Tiene que coincidir con el `SIFEN_API_TOKEN` del Automatizador, o contesta
# 401 — y el SPG lee un 401 como RECHAZADO, o sea «no reintentes».
SIFEN_TOKEN=

# ===========================================================================
#  2. Sólo en el SERVIDOR (docker-compose.produccion.yml)
#
#  En la computadora de desarrollo estas cuatro se dejan como están: el compose
#  de desarrollo no las lee. En el servidor, sin ellas el contenedor se apaga a
#  propósito en vez de arrancar a medias.
# ===========================================================================

# La clave con la que Laravel cifra la sesión y todo lo que guarda cifrado.
# Se genera UNA vez, en el servidor:
#
#   echo "APP_KEY=base64:$(openssl rand -base64 32)"
#
# y se pega acá. **Si se cambia después, las sesiones abiertas y todo lo cifrado
# dejan de leerse.**
#
# Con openssl y no con `artisan key:generate`: ese comando necesita el contenedor
# levantado, y el contenedor se apaga cuando esta clave está vacía — o sea justo
# cuando hace falta. Es lo mismo que hace artisan: 32 bytes al azar en base64.
APP_KEY=

# La contraseña de la base. **Las dos tienen que ser LA MISMA**: la primera la
# usa MariaDB al crearse, la segunda es con la que se conecta Laravel.
# Una larga y al azar; no se tipea nunca a mano.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# El subdominio publicado y a dónde avisa Let's Encrypt si un certificado no se
# pudo renovar. Los lee el Caddyfile.
SPG_DOMINIO=spg.columbiatcc.online
SPG_EMAIL_TLS=
