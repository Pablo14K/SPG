# ---------------------------------------------------------------------------
#  El .env del SERVIDOR. El de desarrollo es `env.docker`, al lado.
#
#  **Las credenciales NO van acá: van en `docker/php/secretos.env`**, que no se
#  versiona. Docker las pasa como variables del contenedor y Laravel las
#  respeta, porque Dotenv arranca inmutable y no pisa lo que ya está puesto.
#  Las claves que salen de ahí quedan escritas abajo VACÍAS a propósito, para
#  que se vea que existen y de dónde vienen.
#
#  Este archivo sí se versiona: si no existiera, Docker crearía una carpeta en
#  su lugar y el montaje fallaría. Lo que hay acá adentro no es secreto — es la
#  configuración del servidor, que puede leer cualquiera sin que eso le sirva
#  de nada.
# ---------------------------------------------------------------------------

APP_NAME="Peluquería Luque"

# `production` apaga las pantallas de depuración del framework.
APP_ENV=production

# Sale de `secretos.env`. Se genera UNA vez y no se cambia: si cambia, las
# sesiones abiertas y todo lo cifrado dejan de leerse.
APP_KEY=

# **false, y esto no es negociable.** Con `true`, cualquier error le muestra al
# visitante la traza completa, y ahí adentro va la contraseña de la base.
APP_DEBUG=false

# **El subdominio real, con https.** De acá salen los enlaces de los correos:
# reprogramar la cita, cancelarla, agregarla al calendario. Con el valor de
# desarrollo, a la clienta le llega un enlace a su propia computadora.
APP_URL=https://spg.columbiatcc.online

# Paraguay quedó fijo en UTC-3. NO dejar en UTC.
APP_TIMEZONE=America/Asuncion
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PY
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` en producción llena el disco y escribe datos de clientas en el log.
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
#  Base de datos
#
#  `bd` es el NOMBRE DEL SERVICIO del compose, y se resuelve solo dentro de la
#  red de los contenedores. No es 127.0.0.1: eso sería el propio contenedor de
#  PHP, que no tiene ninguna base adentro.
#
#  **Se conecta como root, y es deliberado.** Un usuario limitado obligaría a
#  reescribir los 84 DEFINER de las rutinas —el error 1449 que documenta
#  DESPLIEGUE.md— porque las funciones las crea root al importar y las llamaría
#  otro. Adentro del contenedor eso no compra seguridad: la base no publica
#  ningún puerto, así que sólo se llega a ella desde esta misma red privada.
#  Lo que sí importa es que la contraseña no sea `root`, y por eso sale de
#  `secretos.env`.
#
#  La base es `peluqueria_bd`, la que se entrega: catálogo, un local y las dos
#  cuentas del instalador. **Nunca `peluqueria_test`**, que es el mes simulado
#  del QA — son clientas y facturas inventadas, y ese volcado lleva adentro dos
#  correos reales que recibirían recordatorios de citas que no existen.
# ---------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=bd
DB_PORT=3306
DB_DATABASE=peluqueria_bd
DB_USERNAME=root
# Sale de `secretos.env`, y tiene que ser la MISMA que MYSQL_ROOT_PASSWORD.
DB_PASSWORD=

# A archivo, no a `database`: con `database` Laravel crea SUS tablas dentro de
# la base del TCC, que es la que se entrega al salón.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Con HTTPS, la cookie de sesión no tiene por qué viajar en claro.
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
#  Correo saliente — puerto 587
#
#  Por acá salen el código de verificación del registro, la recuperación de
#  contraseña, el segundo factor del cambio de clave y los recordatorios de
#  cita. Si el proveedor bloquea el 587, **una clienta nueva no puede terminar
#  de registrarse**.
#
#  Los nombres son los de Laravel 11+: MAIL_MAILER (no MAIL_TRANSPORT),
#  MAIL_SCHEME (no MAIL_ENCRYPTION) y MAIL_FROM_ADDRESS (no MAIL_FROM_EMAIL).
#  Con los viejos el sistema se queda en `log` y no manda nada sin dar error.
#
#  Usuario y contraseña salen de `secretos.env`.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
#  Facturación electrónica (Automatizador SIFEN)
#
#  Con `false` el módulo no existe en la interfaz. Se enciende recién cuando el
#  salón declara ante la DNIT de verdad.
#
#  En producción va `http`, nunca `simulado`: el modo simulado devuelve un CDC
#  de prueba que NO tiene validez fiscal.
#
#  `sifen` es el nombre del servicio del compose, igual que `bd`.
# ---------------------------------------------------------------------------
SIFEN_ACTIVO=false
SIFEN_MODO=http
SIFEN_URL=http://sifen:8090/
SIFEN_TOKEN=
SIFEN_TIPO_DEFECTO=1
