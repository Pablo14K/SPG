# El .env de DENTRO del contenedor. Se monta encima de /app/.env, así que el
# .env de la computadora no se toca: quien trabaja sin Docker sigue con el suyo.
#
# Existe porque `php artisan serve` NO le pasa el entorno completo al servidor
# que atiende las peticiones: reenvía una lista blanca (APP_ENV, PATH, las de
# Xdebug…) y nada más. Con las credenciales puestas como variables del
# contenedor, los comandos de consola funcionaban y la web no — se conectaba a
# 127.0.0.1 y contestaba «Connection refused». Acá van escritas y no hay
# ambigüedad posible.
#
# APP_KEY se genera sola en el primer arranque y queda escrita acá. Este archivo
# SÍ se versiona, a propósito: si no existiera, Docker crearía una carpeta en su
# lugar y el montaje fallaría. Por eso lo de abajo es config de desarrollo y
# nada más — la contraseña `root` y esta clave valen sólo para el contenedor de
# esta computadora. **En el servidor nunca se usa este archivo**: allá va un
# .env propio, con APP_DEBUG=false y su propia APP_KEY. Ver DESPLIEGUE.md.

APP_NAME="Peluquería Luque"
APP_ENV=local
APP_KEY=base64:WC2cA7RMPZWmnYlFgJDE+Y8FZ3Cg+NA31/xPTUtF0dU=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Asuncion
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PY
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# `bd` es el nombre del servicio en docker-compose.yml, y Docker lo resuelve
# solo dentro de la red de los contenedores. Desde afuera (HeidiSQL, Workbench)
# la misma base se ve en 127.0.0.1:3307.
#
# **ACÁ SE ELIGE CON QUÉ BASE SE TRABAJA.** El contenedor crea e importa las dos
# en el primer arranque (ver docker/bd/10-importar.sh), así que cambiar esta
# línea y reiniciar alcanza — no hace falta `down -v` ni volver a importar:
#
#   DB_DATABASE=peluqueria_test   la base cargada que viaja en el ZIP: 172 citas,
#                                 63 facturas, 33 clientas y la operación del QA.
#   DB_DATABASE=peluqueria_bd     la base limpia de entrega: catálogo y cuentas
#                                 para iniciar un salón desde cero.
#
# **Hoy apunta a `peluqueria_test`, que es la copia cargada que se incluye en
# `basededatos/1mes_simulacion.sql`**: al comprimir la carpeta y levantarla en
# otra computadora, la aplicación abre directamente con citas, clientes,
# facturas, cobros y asistencia. Para entregar un salón desde cero se cambia a
# `peluqueria_bd` y se reinicia.
#
# **Escribí el nombre exacto: son `peluqueria_bd` o `peluqueria_test`, y no hay
# ninguna `peluqueria_bd_test`.** Mezclarlos es fácil y el síntoma engaña: la
# pantalla de ingreso sigue contestando 200 porque no toca la base hasta que se
# aprieta Ingresar, y recién ahí aparece «Unknown database». `spg:diagnostico`
# lo dice en la primera línea.
#
# Las pruebas NO dependen de esto: `phpunit.xml` fija `peluqueria_test` por su
# cuenta, corran como corran. Para mirar cualquiera de las dos desde afuera
# (HeidiSQL, Workbench): 127.0.0.1:3307, root/root.
DB_CONNECTION=mariadb
DB_HOST=bd
DB_PORT=3306
DB_DATABASE=peluqueria_test
DB_USERNAME=root
DB_PASSWORD=root

# A archivo, no a `database`: si no, Laravel crea sus tablas dentro de la base
# del TCC, que es la que se entrega al salón.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En desarrollo va en false: sin HTTPS, una cookie marcada como segura no
# viaja y la sesión no se sostiene. En el servidor va en true.
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Correo saliente. Los nombres son los de Laravel 11+: `MAIL_MAILER` (no
# MAIL_TRANSPORT), `MAIL_SCHEME` (no MAIL_ENCRYPTION) y `MAIL_FROM_ADDRESS` (no
# MAIL_FROM_EMAIL). Con los nombres viejos el sistema se queda en `log` y no
# manda nada, sin dar ningún error.
#
# **En el repositorio va `log`, y es a propósito.** Este archivo SÍ se versiona
# —tiene que existir para que Docker lo monte—, así que una contraseña acá queda
# en el repositorio y en todas sus copias. Ya pasó una vez (6.1.3) y hubo que
# sacarla (6.4.0).
#
# Con `log` no sale ningún correo: el código de verificación, la recuperación,
# el segundo factor y los recordatorios quedan escritos en el log.
#
#     docker compose exec app tail -f storage/logs/laravel.log
#
# `php artisan spg:diagnostico` lo dice en su sección **El correo**, para que no
# parezca que el sistema está roto cuando en realidad está apagado.
#
# **PARA QUE SALGA DE VERDAD**, poné `smtp` y las credenciales acá, en tu copia
# local, y marcá el archivo para que git no las mande:
#
#     git update-index --skip-worktree docker/php/env.docker
#
# **OJO CON ESA MARCA**: mientras esté puesta, NINGÚN cambio de este archivo se
# commitea —ni la contraseña ni el `DB_DATABASE`— y `git status` tampoco los
# muestra. Ya se perdieron cambios así. Para volver a versionar algo:
#
#     git update-index --no-skip-worktree docker/php/env.docker
#     # …y ANTES de commitear, dejá MAIL_PASSWORD vacío
#
# Se comprueba con `git ls-files -v docker/php/env.docker`: una **S** adelante
# quiere decir que está marcado.
#
# El remitente tiene que ser la misma cuenta que se autentica: Gmail rechaza un
# From de otro dominio. Sirven las mismas credenciales que usa el Automatizador
# SIFEN para mandar el PDF del comprobante.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@peluqueria.local"
MAIL_FROM_NAME="${APP_NAME}"


# --- Facturación electrónica (Automatizador SIFEN) --------------------------
# Con SIFEN_ACTIVO=false el módulo no aparece en ninguna pantalla, que es como
# se entrega. En `simulado` el comprobante NO sale de acá: se arma el TXT de
# verdad y se devuelve un CDC de prueba, para poder ver el circuito completo.
# Para mandarlo en serio: SIFEN_MODO=http y la URL del Automatizador.
#
# **`simulado` NO le manda nada al Automatizador**, y por eso en ese modo el PDF
# no le llega a nadie: se arma el TXT, se devuelve un CDC de prueba y ahí
# termina. Si lo que se quiere probar es el correo con el comprobante, hay que
# poner `http` y una URL que conteste.
#
# `sifen` es el nombre del servicio en docker-compose.yml, así que se resuelve
# solo dentro de la red de los contenedores — igual que `bd`. **No pongas
# `localhost`**: adentro del contenedor, localhost es el contenedor mismo.
# Si preferís levantar el Automatizador a mano en Windows en vez de con el
# compose, ahí sí va `http://host.docker.internal:8090/`.
#
# El token tiene que ser el `SIFEN_API_TOKEN` del .env DEL AUTOMATIZADOR. Si no
# coincide contesta 401, y el SPG lo toma como RECHAZADO.
SIFEN_ACTIVO=true
SIFEN_MODO=http
SIFEN_URL=http://sifen:8090/
SIFEN_TOKEN=TOKEN_LARGO_ALEATORIO_4F8A2C
SIFEN_TIPO_DEFECTO=8
