APP_NAME="Peluquería Luque"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Paraguay quedó fijo en UTC-3. NO dejar en UTC: `ahora_bd()` sella el fichaje
# de asistencia con la hora de la base, y una hora corrida no sirve para nada.
APP_TIMEZONE=America/Asuncion

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PY
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# La base. Acá vive TODA la lógica de negocio: 20 procedimientos, 30 funciones,
# 17 triggers, 17 vistas y 54 CHECK. Laravel los consume, no los reimplementa.
#
#   peluqueria_bd    la que se entrega: esquema al día y vacía de operación
#   peluqueria_test  para desarrollar y probar, con el mes simulado del QA
#
# En desarrollo se apunta a peluqueria_test, así la que se entrega no se ensucia.
# ---------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peluqueria_test
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sesiones, caché y colas van a ARCHIVO, no a `database`, que es lo que trae
# Laravel de fábrica. Con `database` el framework crea sus tablas (sessions,
# cache, jobs, migrations…) DENTRO de la base del TCC, que es la que se entrega
# al salón y no puede llevarlas. `php artisan spg:diagnostico` lo verifica.
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Correo. Con MAIL_MAILER=log no sale nada y los códigos quedan escritos en
# storage/logs/laravel.log — alcanza para desarrollar. Para probar envíos de
# verdad, poné `smtp` y cargá usuario y contraseña de aplicación de Gmail.
# Por acá salen el código de verificación, la recuperación de contraseña, el
# segundo factor del cambio de contraseña y los recordatorios de cita.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@peluqueriluque.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Facturación electrónica (Automatizador SIFEN) --------------------------
# Apagado por defecto: con `false` el módulo no aparece en ninguna pantalla, y
# un salón que no factura electrónicamente no tiene por qué verlo.
#
# `simulado` arma el TXT de verdad pero NO lo manda: devuelve un CDC de prueba,
# para recorrer el circuito sin depender del servicio. Para mandarlo en serio:
# SIFEN_MODO=http más la URL y el token del Automatizador.
#
# SIFEN_TIPO_DEFECTO es el comprobante que se propone al cobrar. 3 = Ticket,
# porque la clienta no siempre pide factura.
SIFEN_ACTIVO=false
SIFEN_MODO=simulado
SIFEN_URL=
SIFEN_TOKEN=
SIFEN_TIPO_DEFECTO=3
