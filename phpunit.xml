<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        Una sola suite, y es de integración. No hay «Unit» porque acá no hay
        casi nada que probar en aislamiento: la lógica vive en la base, así
        que una prueba que no la toque no prueba el sistema. La carpeta
        tests/Unit sólo tenía el assertTrue(true) que trae Laravel de fábrica.
    -->
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Las pruebas corren contra `peluqueria_test`, NO contra sqlite en
            memoria: lo que hay que probar son los procedimientos, las
            funciones y los disparadores de MariaDB, y sqlite no los tiene.
            Esa base se recrea con el guion documentado en el CLAUDE.md.

            OJO: nada de RefreshDatabase ni DatabaseMigrations acá. Borrarían
            una base cuyo esquema NO lo crean las migraciones de Laravel, y no
            habría forma de reconstruirlo.
        -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_DATABASE" value="peluqueria_test"/>
        <env name="DB_URL" value=""/>
        <env name="APP_TIMEZONE" value="America/Asuncion"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
