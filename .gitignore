# La salida del banco de pruebas de QA, no el banco.
# `_sim/` y `_sim60/` son la herramienta y se versionan; sus `log/` son lo que
# escupe una corrida —megas de operaciones crudas— y envejecen al día
# siguiente. El resultado que sí importa está en el informe, que sí se commitea.
_sim/log/
_sim60/log/
_sim30/log/

# El banco adversario se versiona; sus corridas no.
_qa/log/

# Las credenciales del contenedor. La plantilla es secretos.env.example.
docker/php/secretos.env

# Los respaldos de la base del servidor. Son datos de un salón real: no van al
# repositorio ni por accidente. La carpeta sí, para que exista.
respaldos/*
!respaldos/.gitkeep
